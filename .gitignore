# Ignore rules for check_status_2107_01.
#
# Every pattern below names an artifact that one of the repository's documented
# commands actually produces, so nothing here is speculative. The converse
# matters just as much: `large.csv` is deliberately NOT ignored, because it is a
# committed dataset that the README's verification runbook checks by row count
# and content. Editor, IDE and OS patterns are intentionally omitted too.

# Installed dependency tree, materialised by `npm install` / `npm ci` and
# reproducible in full from `package.json` plus `package-lock.json` (67
# packages, pinned to express 5.2.1). Committing it would only add redundant,
# platform-specific noise. This entry is what makes the README's statement that
# `node_modules/` is git-ignored true.
node_modules/

# npm failure logs: transient diagnostic output, written only when a command
# crashes, and never part of the source of record.
npm-debug.log*

# Local environment overrides -- the server reads `PORT` from the environment.
# These files hold machine-specific and potentially sensitive values, so they
# must never be committed.
.env

# Generated JSDoc HTML API reference, emitted into this directory by
# `npm run docs`. Regenerate it on demand; committing it would create a second,
# silently stale documentation of record beside the annotated `server.js`.
docs-api/

# Python byte-cache, written by the interpreter whenever this repository's
# Python modules are imported, for example while verifying the dataset
# generator. Machine- and version-specific build output, never source.
__pycache__/
