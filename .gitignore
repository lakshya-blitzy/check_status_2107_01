# Installed dependencies; reproducible from `package.json` and
# `package-lock.json`.
node_modules/

# npm failure diagnostics.
npm-debug.log*

# Local `.env` file; may hold machine-specific and sensitive values.
.env

# Generated JSDoc HTML API reference, emitted into this directory by
# `npm run docs`. Regenerate it on demand; committing it would create a second,
# silently stale documentation of record beside the annotated `server.js`.
docs-api/

# Python bytecode cache, which the interpreter normally writes when it imports a
# module from this repository unless bytecode writing is disabled.
__pycache__/
