{
  // Rule overrides. Only rules with measured evidence behind them appear here.
  "config": {
    // Disabled: the default 80-column limit conflicts with content this
    // repository keeps deliberately wide. The tracked README's lead paragraph
    // is a single 218-character line preserved verbatim, and a table wide
    // enough to carry a full response contract cannot be rewrapped to 80
    // columns while keeping the pipe alignment MD060 requires. A larger finite
    // ceiling would only postpone the conflict and invite mangling the table.
    "MD013": false,

    // Enforced. This restates the markdownlint default so the choice is
    // visible rather than inherited: a bare URL renders inconsistently across
    // processors and gives a screen-reader user an address instead of link
    // text.
    //
    // Satisfy it with an inline code span, not with the `<...>` autolink form.
    // markdown-link-check probes an autolink and fails when nothing is
    // listening on the address, which is the usual outcome for a localhost
    // example; a code span is neither a bare URL nor a link, so it satisfies
    // this rule and is never probed. That is why no link-check ignore list is
    // needed.
    "MD034": true,

    // Enforced with style "aligned", which is stricter than the default
    // "consistent": every pipe must sit at the same character offset on the
    // header, delimiter and body rows, so a single cell one character too wide
    // yields one finding per misplaced pipe. A contract table is read as data,
    // so its columns are padded to align in the source; the response to a
    // finding is to pad the table rather than to relax this entry.
    "MD060": { "style": "aligned" }
  },

  // Linted when markdownlint-cli2 runs with no glob argument. Identical to the
  // glob in the `lint:md` script of `package.json`, so a bare invocation and
  // `npm run lint:md` cannot examine different file sets, and recursive so it
  // covers Markdown anywhere in the repository.
  "globs": ["**/*.md"],

  // Excluded because neither tree is this repository's source of record:
  // `node_modules/` holds Markdown vendored by installed dependencies, and
  // `docs-api/` holds generated JSDoc output from `npm run docs`. Both are
  // git-ignored.
  "ignores": ["node_modules/**", "docs-api/**"]
}
